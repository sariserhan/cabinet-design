{
  "name": "cabinet-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:backend && npm run check:benchmark",
    "check:benchmark": "python3 tools/check_benchmark_packet.py",
    "dev": "next dev --hostname 127.0.0.1",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint src convex tools/worker.ts tests/core tests/e2e playwright.config.ts",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/core/*.test.ts",
    "test:backend": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "verify": "npm run check && npm run build",
    "worker": "tsx --env-file=.env.local tools/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/auth": "^0.0.95",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "fflate": "0.8.3",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "openai": "^7.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "9.3.10",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "0.0.24",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "convex-test": "^0.0.58",
    "eslint": "^10.10.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
